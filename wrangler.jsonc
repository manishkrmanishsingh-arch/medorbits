<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Private Job Assistance | MedOrbit</title>

  <meta
    name="description"
    content="Find private-sector jobs through MedOrbit, including cleaning, housekeeping, delivery, drivers, warehouse, hospital, retail, airport, aviation, IT, corporate and management jobs."
  >

  <meta
    name="keywords"
    content="private jobs, airport jobs, housekeeping jobs, cleaning jobs, delivery jobs, driver jobs, hospital jobs, warehouse jobs, corporate jobs, MedOrbit jobs"
  >

  <style>
    :root {
      --primary: #063f78;
      --primary-dark: #042d57;
      --secondary: #d6a625;
      --accent: #0e78c7;
      --light-blue: #eef6ff;
      --light-yellow: #fff8e6;
      --background: #f5f8fc;
      --white: #ffffff;
      --text: #172033;
      --muted: #667085;
      --border: #dde5ee;
      --success: #16803d;
      --danger: #c93535;
      --shadow: 0 18px 45px rgba(18, 55, 92, 0.1);
      --radius: 18px;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: var(--background);
      color: var(--text);
      line-height: 1.6;
    }

    img {
      max-width: 100%;
      display: block;
    }

    a {
      color: inherit;
    }

    button,
    input,
    select,
    textarea {
      font: inherit;
    }

    .container {
      width: min(1180px, 92%);
      margin: auto;
    }

    /* Header */

    .topbar {
      background: var(--primary-dark);
      color: var(--white);
      font-size: 13px;
    }

    .topbar-inner {
      min-height: 38px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
    }

    .topbar-info {
      display: flex;
      flex-wrap: wrap;
      gap: 18px;
    }

    .topbar a {
      text-decoration: none;
    }

    header {
      background: rgba(255, 255, 255, 0.98);
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 1000;
      backdrop-filter: blur(12px);
    }

    .navbar {
      min-height: 76px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
    }

    .logo {
      text-decoration: none;
      font-family: "Times New Roman", Times, serif;
      font-size: 31px;
      font-weight: 700;
      color: var(--primary);
      white-space: nowrap;
    }

    .logo span {
      color: var(--secondary);
    }

    nav {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    nav a {
      text-decoration: none;
      font-size: 15px;
      font-weight: 700;
      color: #31415a;
      transition: 0.2s;
    }

    nav a:hover,
    nav a.active {
      color: var(--accent);
    }

    .nav-button {
      background: var(--primary);
      color: var(--white);
      padding: 11px 18px;
      border-radius: 10px;
    }

    .nav-button:hover {
      color: var(--white);
      background: var(--primary-dark);
    }

    .menu-button {
      display: none;
      width: 44px;
      height: 44px;
      border: 1px solid var(--border);
      background: var(--white);
      border-radius: 10px;
      cursor: pointer;
      font-size: 22px;
    }

    /* Hero */

    .hero {
      background:
        linear-gradient(
          125deg,
          rgba(4, 45, 87, 0.97),
          rgba(8, 92, 157, 0.92)
        );
      color: var(--white);
      padding: 86px 0 76px;
      overflow: hidden;
      position: relative;
    }

    .hero::before,
    .hero::after {
      content: "";
      position: absolute;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.07);
    }

    .hero::before {
      width: 340px;
      height: 340px;
      right: -100px;
      top: -130px;
    }

    .hero::after {
      width: 260px;
      height: 260px;
      left: -120px;
      bottom: -130px;
    }

    .hero-content {
      position: relative;
      z-index: 2;
      display: grid;
      grid-template-columns: 1.3fr 0.7fr;
      gap: 55px;
      align-items: center;
    }

    .eyebrow {
      color: #ffd873;
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-bottom: 13px;
    }

    .hero h1 {
      font-family: "Times New Roman", Times, serif;
      font-size: clamp(42px, 6vw, 70px);
      line-height: 1.06;
      margin-bottom: 22px;
    }

    .hero-description {
      max-width: 730px;
      font-size: 18px;
      color: #e7eff8;
      margin-bottom: 28px;
    }

    .hero-points {
      display: flex;
      flex-wrap: wrap;
      gap: 11px;
      margin-bottom: 32px;
    }

    .hero-point {
      background: rgba(255, 255, 255, 0.12);
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 999px;
      padding: 8px 13px;
      font-size: 13px;
      font-weight: 700;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 13px;
    }

    .button {
      border: none;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex;
      justify-content: center;
      align-items: center;
      min-height: 48px;
      padding: 0 21px;
      border-radius: 11px;
      font-weight: 800;
      transition: 0.2s ease;
    }

    .button-primary {
      background: var(--secondary);
      color: #222;
    }

    .button-primary:hover {
      transform: translateY(-2px);
      background: #e6b936;
    }

    .button-outline {
      color: var(--white);
      border: 1px solid rgba(255, 255, 255, 0.45);
      background: rgba(255, 255, 255, 0.08);
    }

    .button-outline:hover {
      background: var(--white);
      color: var(--primary);
    }

    .hero-card {
      background: var(--white);
      color: var(--text);
      border-radius: 24px;
      padding: 28px;
      box-shadow: 0 25px 65px rgba(0, 0, 0, 0.2);
    }

    .hero-card h2 {
      font-family: "Times New Roman", Times, serif;
      color: var(--primary);
      margin-bottom: 8px;
      font-size: 29px;
    }

    .hero-card p {
      color: var(--muted);
      font-size: 14px;
      margin-bottom: 20px;
    }

    .quick-form {
      display: grid;
      gap: 13px;
    }

    .input-group label {
      display: block;
      font-size: 13px;
      font-weight: 800;
      margin-bottom: 6px;
      color: #344054;
    }

    .input-group input,
    .input-group select,
    .input-group textarea {
      width: 100%;
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 12px 13px;
      outline: none;
      background: var(--white);
    }

    .input-group input:focus,
    .input-group select:focus,
    .input-group textarea:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(14, 120, 199, 0.1);
    }

    .full-button {
      width: 100%;
      background: var(--primary);
      color: var(--white);
    }

    .full-button:hover {
      background: var(--primary-dark);
    }

    /* Stats */

    .stats {
      background: var(--white);
      box-shadow: var(--shadow);
      border-radius: var(--radius);
      margin-top: -35px;
      position: relative;
      z-index: 5;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      overflow: hidden;
    }

    .stat {
      padding: 25px 20px;
      text-align: center;
      border-right: 1px solid var(--border);
    }

    .stat:last-child {
      border-right: 0;
    }

    .stat strong {
      display: block;
      font-family: "Times New Roman", Times, serif;
      font-size: 31px;
      color: var(--primary);
    }

    .stat span {
      color: var(--muted);
      font-size: 13px;
    }

    /* General sections */

    section {
      padding: 75px 0;
    }

    .section-header {
      display: flex;
      justify-content: space-between;
      align-items: end;
      gap: 30px;
      margin-bottom: 32px;
    }

    .section-header h2 {
      font-family: "Times New Roman", Times, serif;
      font-size: clamp(32px, 4vw, 45px);
      color: var(--primary-dark);
      line-height: 1.15;
    }

    .section-header p {
      max-width: 680px;
      color: var(--muted);
    }

    /* Search area */

    .job-search-panel {
      background: var(--white);
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
      border-radius: var(--radius);
      padding: 24px;
    }

    .job-search-form {
      display: grid;
      grid-template-columns: 1.4fr 1fr 1fr auto;
      gap: 12px;
    }

    .job-search-form input,
    .job-search-form select {
      min-height: 51px;
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 0 14px;
      outline: none;
    }

    .job-search-form input:focus,
    .job-search-form select:focus {
      border-color: var(--accent);
    }

    /* Categories */

    .categories-section {
      background: var(--white);
    }

    .category-filters {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 28px;
    }

    .filter-button {
      border: 1px solid var(--border);
      background: var(--white);
      color: #344054;
      padding: 9px 14px;
      border-radius: 999px;
      cursor: pointer;
      font-weight: 700;
      font-size: 13px;
    }

    .filter-button:hover,
    .filter-button.active {
      color: var(--white);
      border-color: var(--primary);
      background: var(--primary);
    }

    .category-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 17px;
    }

    .category-card {
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 21px;
      background: var(--white);
      transition: 0.22s;
      cursor: pointer;
      min-height: 165px;
    }

    .category-card:hover {
      transform: translateY(-5px);
      border-color: #b8d2ea;
      box-shadow: var(--shadow);
    }

    .category-icon {
      width: 46px;
      height: 46px;
      display: grid;
      place-items: center;
      background: var(--light-blue);
      border-radius: 12px;
      font-size: 23px;
      margin-bottom: 15px;
    }

    .category-card h3 {
      font-size: 17px;
      color: var(--primary-dark);
      margin-bottom: 6px;
      line-height: 1.35;
    }

    .category-card p {
      color: var(--muted);
      font-size: 13px;
    }

    /* Jobs */

    .jobs-section {
      background: #f4f7fb;
    }

    .jobs-layout {
      display: grid;
      grid-template-columns: 270px 1fr;
      gap: 25px;
      align-items: start;
    }

    .sidebar {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 21px;
      position: sticky;
      top: 95px;
    }

    .sidebar h3 {
      color: var(--primary-dark);
      margin-bottom: 18px;
      font-family: "Times New Roman", Times, serif;
      font-size: 24px;
    }

    .filter-group {
      margin-bottom: 22px;
    }

    .filter-group h4 {
      margin-bottom: 10px;
      font-size: 14px;
    }

    .checkbox-row {
      display: flex;
      align-items: center;
      gap: 9px;
      margin-bottom: 9px;
      color: #475467;
      font-size: 13px;
    }

    .checkbox-row input {
      accent-color: var(--primary);
    }

    .jobs-list {
      display: grid;
      gap: 17px;
    }

    .job-card {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: 17px;
      padding: 23px;
      transition: 0.2s;
    }

    .job-card:hover {
      box-shadow: var(--shadow);
      transform: translateY(-2px);
    }

    .job-top {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 18px;
      margin-bottom: 15px;
    }

    .job-company-logo {
      width: 55px;
      height: 55px;
      flex: 0 0 55px;
      border-radius: 13px;
      background: var(--light-blue);
      color: var(--primary);
      display: grid;
      place-items: center;
      font-size: 22px;
      font-weight: 800;
    }

    .job-main-info {
      display: flex;
      gap: 15px;
    }

    .job-title h3 {
      color: var(--primary-dark);
      font-size: 20px;
      line-height: 1.25;
      margin-bottom: 4px;
    }

    .job-title p {
      color: var(--muted);
      font-size: 14px;
    }

    .save-button {
      border: 1px solid var(--border);
      background: var(--white);
      width: 40px;
      height: 40px;
      border-radius: 10px;
      cursor: pointer;
      font-size: 18px;
    }

    .save-button.saved {
      color: var(--danger);
      background: #fff1f1;
    }

    .job-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: 15px 0;
    }

    .job-tag {
      background: #f1f5f9;
      color: #455468;
      padding: 6px 10px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 700;
    }

    .verified-tag {
      color: var(--success);
      background: #eaf8ef;
    }

    .job-description {
      color: var(--muted);
      font-size: 14px;
      margin-bottom: 18px;
    }

    .job-bottom {
      border-top: 1px solid var(--border);
      padding-top: 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
    }

    .salary {
      color: var(--primary-dark);
      font-weight: 800;
    }

    .salary small {
      color: var(--muted);
      font-weight: 500;
    }

    .apply-button {
      background: var(--primary);
      color: var(--white);
      min-height: 41px;
      padding: 0 17px;
      border-radius: 9px;
      border: none;
      cursor: pointer;
      font-weight: 800;
    }

    .apply-button:hover {
      background: var(--primary-dark);
    }

    .no-results {
      display: none;
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 35px;
      text-align: center;
      color: var(--muted);
    }

    /* Assistance */

    .assistance-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .assistance-card {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: 17px;
      padding: 25px;
      box-shadow: 0 8px 30px rgba(12, 45, 79, 0.05);
    }

    .assistance-card h3 {
      color: var(--primary-dark);
      margin: 12px 0 8px;
    }

    .assistance-card p {
      color: var(--muted);
      font-size: 14px;
    }

    /* Process */

    .process-section {
      background: var(--primary-dark);
      color: var(--white);
    }

    .process-section .section-header h2 {
      color: var(--white);
    }

    .process-section .section-header p {
      color: #cbd8e6;
    }

    .process-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
    }

    .process-card {
      border: 1px solid rgba(255, 255, 255, 0.13);
      background: rgba(255, 255, 255, 0.06);
      border-radius: 16px;
      padding: 23px;
    }

    .process-number {
      width: 40px;
      height: 40px;
      display: grid;
      place-items: center;
      background: var(--secondary);
      color: #1d1d1d;
      border-radius: 50%;
      font-weight: 900;
      margin-bottom: 15px;
    }

    .process-card h3 {
      margin-bottom: 7px;
    }

    .process-card p {
      color: #cbd8e6;
      font-size: 14px;
    }

    /* Employer */

    .employer-banner {
      background:
        linear-gradient(120deg, var(--light-yellow), var(--light-blue));
      border: 1px solid #e4e9ef;
      border-radius: 24px;
      padding: 42px;
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 35px;
      align-items: center;
    }

    .employer-banner h2 {
      font-family: "Times New Roman", Times, serif;
      color: var(--primary-dark);
      font-size: clamp(30px, 4vw, 44px);
      line-height: 1.15;
      margin-bottom: 10px;
    }

    .employer-banner p {
      color: var(--muted);
      max-width: 750px;
    }

    /* Disclaimer */

    .disclaimer {
      background: #fff8e1;
      border: 1px solid #efd88d;
      border-radius: 14px;
      padding: 18px;
      font-size: 13px;
      color: #6a5413;
      margin-top: 30px;
    }

    /* Footer */

    footer {
      background: #071f38;
      color: var(--white);
      padding: 55px 0 20px;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
      gap: 40px;
      margin-bottom: 35px;
    }

    .footer-about p {
      color: #b9c6d4;
      margin-top: 13px;
      font-size: 14px;
    }

    .footer-column h3 {
      margin-bottom: 15px;
      font-size: 17px;
    }

    .footer-column a {
      display: block;
      color: #b9c6d4;
      text-decoration: none;
      font-size: 14px;
      margin-bottom: 8px;
    }

    .footer-column a:hover {
      color: var(--white);
    }

    .footer-bottom {
      border-top: 1px solid rgba(255, 255, 255, 0.12);
      padding-top: 20px;
      color: #9eb0c1;
      font-size: 13px;
      display: flex;
      justify-content: space-between;
      gap: 20px;
    }

    /* Modal */

    .modal {
      position: fixed;
      inset: 0;
      background: rgba(3, 20, 38, 0.72);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
      z-index: 2000;
    }

    .modal.active {
      display: flex;
    }

    .modal-content {
      width: min(560px, 100%);
      max-height: 92vh;
      overflow-y: auto;
      background: var(--white);
      border-radius: 18px;
      padding: 26px;
      position: relative;
    }

    .close-modal {
      position: absolute;
      right: 17px;
      top: 14px;
      border: none;
      background: transparent;
      font-size: 27px;
      cursor: pointer;
    }

    .modal-content h2 {
      font-family: "Times New Roman", Times, serif;
      color: var(--primary-dark);
      margin-bottom: 7px;
    }

    .modal-content > p {
      color: var(--muted);
      font-size: 14px;
      margin-bottom: 20px;
    }

    .application-form {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }

    .application-form .full-width {
      grid-column: 1 / -1;
    }

    .success-message {
      display: none;
      background: #eaf8ef;
      color: var(--success);
      border: 1px solid #b9e2c7;
      padding: 13px;
      border-radius: 10px;
      margin-top: 14px;
      font-size: 14px;
      font-weight: 700;
    }

    /* Responsive */

    @media (max-width: 1050px) {
      .category-grid {
        grid-template-columns: repeat(3, 1fr);
      }

      .job-search-form {
        grid-template-columns: 1fr 1fr;
      }

      .process-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .footer-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 850px) {
      .topbar {
        display: none;
      }

      .menu-button {
        display: block;
      }

      nav {
        display: none;
        position: absolute;
        left: 4%;
        right: 4%;
        top: 76px;
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 18px;
        flex-direction: column;
        align-items: stretch;
        box-shadow: var(--shadow);
      }

      nav.open {
        display: flex;
      }

      nav a {
        padding: 9px;
      }

      .hero-content {
        grid-template-columns: 1fr;
      }

      .hero-card {
        max-width: 620px;
      }

      .stats {
        grid-template-columns: repeat(2, 1fr);
      }

      .stat:nth-child(2) {
        border-right: 0;
      }

      .stat:nth-child(-n + 2) {
        border-bottom: 1px solid var(--border);
      }

      .category-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .jobs-layout {
        grid-template-columns: 1fr;
      }

      .sidebar {
        position: static;
      }

      .assistance-grid {
        grid-template-columns: 1fr;
      }

      .employer-banner {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 590px) {
      .hero {
        padding: 58px 0 65px;
      }

      section {
        padding: 56px 0;
      }

      .hero h1 {
        font-size: 43px;
      }

      .hero-description {
        font-size: 16px;
      }

      .stats {
        margin-top: -24px;
      }

      .category-grid,
      .process-grid,
      .footer-grid {
        grid-template-columns: 1fr;
      }

      .job-search-form {
        grid-template-columns: 1fr;
      }

      .section-header {
        align-items: flex-start;
        flex-direction: column;
      }

      .job-top,
      .job-bottom {
        align-items: flex-start;
      }

      .job-main-info {
        flex-direction: column;
      }

      .job-bottom {
        flex-direction: column;
      }

      .apply-button {
        width: 100%;
      }

      .application-form {
        grid-template-columns: 1fr;
      }

      .application-form .full-width {
        grid-column: auto;
      }

      .employer-banner {
        padding: 27px;
      }

      .footer-bottom {
        flex-direction: column;
      }
    }
  </style>
</head>

<body>

  <div class="topbar">
    <div class="container topbar-inner">
      <div class="topbar-info">
        <span>Private Job Assistance Across India</span>
        <a href="tel:+919142102309">Call: +91 91421 02309</a>
      </div>

      <div class="topbar-info">
        <span>Candidate Support</span>
        <span>Employer Hiring Support</span>
      </div>
    </div>
  </div>

  <header>
    <div class="container navbar">
      <a href="index.html" class="logo">
        Med<span>Orbit</span>
      </a>

      <button
        class="menu-button"
        id="menuButton"
        aria-label="Open navigation"
      >
        ☰
      </button>

      <nav id="mainNavigation">
        <a href="index.html">Home</a>
        <a href="courses.html">Education</a>
        <a href="jobs.html" class="active">Jobs</a>
        <a href="admission-guide.html">Admission Guide</a>
        <a href="contact.html">Contact</a>
        <a href="#employer" class="nav-button">Post a Job</a>
      </nav>
    </div>
  </header>

  <main>

    <section class="hero">
      <div class="container hero-content">

        <div>
          <p class="eyebrow">MedOrbit Private Job Assistance</p>

          <h1>
            Every private job, from cleaning work to airport careers
          </h1>

          <p class="hero-description">
            Find private-sector opportunities for every skill and education
            level, including garbage cleaning, sanitation, housekeeping,
            drivers, helpers, factories, hospitals, retail, offices, airport
            ground staff, aviation, IT and management.
          </p>

          <div class="hero-points">
            <span class="hero-point">Entry-Level Jobs</span>
            <span class="hero-point">Skilled Work</span>
            <span class="hero-point">Airport Jobs</span>
            <span class="hero-point">Healthcare Jobs</span>
            <span class="hero-point">Corporate Jobs</span>
            <span class="hero-point">Fresher Jobs</span>
          </div>

          <div class="hero-actions">
            <a href="#latestJobs" class="button button-primary">
              Find Jobs
            </a>

            <a href="#jobAssistance" class="button button-outline">
              Get Job Assistance
            </a>
          </div>
        </div>

        <aside class="hero-card">
          <h2>Get Job Assistance</h2>

          <p>
            Submit your basic details. The MedOrbit team can contact you
            regarding suitable private-sector opportunities.
          </p>

          <form class="quick-form" id="quickAssistanceForm">

            <div class="input-group">
              <label for="quickName">Full Name</label>
              <input
                type="text"
                id="quickName"
                placeholder="Enter your name"
                required
              >
            </div>

            <div class="input-group">
              <label for="quickPhone">Mobile Number</label>
              <input
                type="tel"
                id="quickPhone"
                placeholder="Enter mobile number"
                required
              >
            </div>

            <div class="input-group">
              <label for="quickCategory">Preferred Job</label>

              <select id="quickCategory" required>
                <option value="">Select job category</option>
                <option>Cleaning and Sanitation</option>
                <option>Housekeeping</option>
                <option>Helper and Labour</option>
                <option>Driver and Delivery</option>
                <option>Warehouse and Factory</option>
                <option>Security</option>
                <option>Retail and Sales</option>
                <option>Hospital and Healthcare</option>
                <option>Airport and Aviation</option>
                <option>Office and Corporate</option>
                <option>IT and Technical</option>
                <option>Other Private Job</option>
              </select>
            </div>

            <div class="input-group">
              <label for="quickLocation">Preferred Location</label>
              <input
                type="text"
                id="quickLocation"
                placeholder="City or state"
              >
            </div>

            <button type="submit" class="button full-button">
              Submit Details
            </button>

            <div
              class="success-message"
              id="quickSuccessMessage"
            >
              Your details have been submitted successfully.
            </div>

          </form>
        </aside>

      </div>
    </section>

    <div class="container">
      <div class="stats">

        <div class="stat">
          <strong>50+</strong>
          <span>Job categories supported</span>
        </div>

        <div class="stat">
          <strong>All India</strong>
          <span>Location-based job search</span>
        </div>

        <div class="stat">
          <strong>Private</strong>
          <span>Private-sector focused platform</span>
        </div>

        <div class="stat">
          <strong>All Levels</strong>
          <span>Basic work to management</span>
        </div>

      </div>
    </div>

    <section>
      <div class="container">

        <div class="section-header">
          <div>
            <p class="eyebrow">Search Opportunities</p>
            <h2>Search private jobs</h2>
          </div>

          <p>
            Search by job title, skill, city or work category. The demo
            vacancies below can later be replaced with real jobs from your
            database.
          </p>
        </div>

        <div class="job-search-panel">
          <form class="job-search-form" id="mainJobSearch">

            <input
              type="search"
              id="searchKeyword"
              placeholder="Job title, skill or company"
            >

            <input
              type="search"
              id="searchLocation"
              placeholder="City or location"
            >

            <select id="searchCategory">
              <option value="">All Categories</option>
              <option value="cleaning">Cleaning and Sanitation</option>
              <option value="housekeeping">Housekeeping</option>
              <option value="labour">Labour and Helpers</option>
              <option value="driver">Drivers and Delivery</option>
              <option value="warehouse">Warehouse and Factory</option>
              <option value="security">Security</option>
              <option value="retail">Retail and Sales</option>
              <option value="hospital">Healthcare</option>
              <option value="airport">Airport and Aviation</option>
              <option value="office">Office and Corporate</option>
              <option value="it">IT and Technical</option>
            </select>

            <button type="submit" class="button full-button">
              Search
            </button>

          </form>
        </div>

      </div>
    </section>

    <section class="categories-section" id="jobCategories">
      <div class="container">

        <div class="section-header">
          <div>
            <p class="eyebrow">Complete Job Coverage</p>
            <h2>Explore all private job categories</h2>
