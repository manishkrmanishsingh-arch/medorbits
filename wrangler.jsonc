    <section id="jobAssistance">
      <div class="container">

        <div class="section-header">
          <div>
            <p class="eyebrow">Candidate Services</p>
            <h2>Complete job assistance</h2>
          </div>

          <p>
            You can later activate these services one by one without changing
            the entire layout.
          </p>
        </div>

        <div class="assistance-grid">

          <article class="assistance-card">
            <div class="category-icon">📄</div>
            <h3>Resume Assistance</h3>
            <p>
              Help candidates prepare simple, professional resumes suitable
              for private employers.
            </p>
          </article>

          <article class="assistance-card">
            <div class="category-icon">🎯</div>
            <h3>Job Matching</h3>
            <p>
              Match candidates with available roles based on location, skills,
              education and experience.
            </p>
          </article>

          <article class="assistance-card">
            <div class="category-icon">🗣️</div>
            <h3>Interview Preparation</h3>
            <p>
              Provide basic interview guidance, communication support and
              employer-specific preparation.
            </p>
          </article>

          <article class="assistance-card">
            <div class="category-icon">🧾</div>
            <h3>Document Guidance</h3>
            <p>
              Explain which documents may be required for joining, background
              verification or airport entry formalities.
            </p>
          </article>

          <article class="assistance-card">
            <div class="category-icon">📍</div>
