          <article class="assistance-card">
            <div class="category-icon">📲</div>
            <h3>Job Alerts</h3>
            <p>
              Later connect email, SMS or WhatsApp alerts for suitable
              vacancies and interview updates.
            </p>
          </article>

        </div>

      </div>
    </section>

    <section class="process-section">
      <div class="container">

