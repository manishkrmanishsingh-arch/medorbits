  <!-- Candidate Application Modal -->

  <div class="modal" id="applicationModal">

    <div class="modal-content">

      <button
        class="close-modal"
        data-close-modal="applicationModal"
        aria-label="Close"
      >
        ×
      </button>

      <h2>Apply for Job</h2>

      <p id="selectedJobText">
        Submit your details for this opportunity.
      </p>

      <form class="application-form" id="applicationForm">

        <div class="input-group">
          <label for="candidateName">Full Name</label>
          <input
            type="text"
            id="candidateName"
            required
          >
        </div>

        <div class="input-group">
          <label for="candidatePhone">Mobile Number</label>
          <input
            type="tel"
            id="candidatePhone"
            required
          >
        </div>

        <div class="input-group">
          <label for="candidateEmail">Email Address</label>
          <input
            type="email"
            id="candidateEmail"
          >
        </div>

        <div class="input-group">
          <label for="candidateCity">Current City</label>
          <input
            type="text"
            id="candidateCity"
            required
          >
        </div>

        <div class="input-group">
          <label for="candidateEducation">Education</label>
          <select id="candidateEducation">
            <option>No Formal Education</option>
            <option>Below 10th</option>
            <option>10th Pass</option>
            <option>12th Pass</option>
            <option>ITI</option>
            <option>Diploma</option>
            <option>Graduate</option>
            <option>Postgraduate</option>
            <option>Professional Degree</option>
          </select>
        </div>

        <div class="input-group">
          <label for="candidateExperience">Experience</label>
          <select id="candidateExperience">
            <option>Fresher</option>
            <option>Less than 1 year</option>
            <option>1–3 years</option>
            <option>3–5 years</option>
            <option>More than 5 years</option>
          </select>
        </div>

        <div class="input-group full-width">
          <label for="candidateMessage">
            Skills or Additional Information
          </label>

          <textarea
            id="candidateMessage"
            rows="4"
            placeholder="Mention your skills, licence, preferred location or availability"
          ></textarea>
        </div>

        <button
          type="submit"
          class="button full-button full-width"
        >
          Submit Application
        </button>

        <div
          class="success-message full-width"
          id="applicationSuccess"
        >
          Your job application has been submitted successfully.
        </div>

      </form>

    </div>
  </div>

  <!-- Employer Modal -->

  <div class="modal" id="employerModal">

    <div class="modal-content">

      <button
        class="close-modal"
        data-close-modal="employerModal"
        aria-label="Close"
      >
        ×
      </button>

      <h2>Submit Hiring Requirement</h2>

      <p>
        Employers and recruiters can provide their private hiring
        requirements here.
      </p>

      <form class="application-form" id="employerForm">

        <div class="input-group">
          <label for="companyName">Company Name</label>
          <input
            type="text"
            id="companyName"
            required
          >
        </div>

        <div class="input-group">
          <label for="contactPerson">Contact Person</label>
          <input
            type="text"
            id="contactPerson"
            required
          >
        </div>

        <div class="input-group">
          <label for="employerPhone">Mobile Number</label>
          <input
            type="tel"
            id="employerPhone"
            required
          >
        </div>

        <div class="input-group">
          <label for="employerEmail">Email Address</label>
          <input
            type="email"
            id="employerEmail"
            required
          >
        </div>

        <div class="input-group">
          <label for="jobTitle">Job Title</label>
          <input
            type="text"
            id="jobTitle"
            placeholder="Example: Housekeeping Staff"
            required
          >
        </div>

        <div class="input-group">
          <label for="vacancies">Number of Vacancies</label>
          <input
            type="number"
            id="vacancies"
            min="1"
            value="1"
            required
          >
        </div>

        <div class="input-group">
          <label for="jobLocation">Job Location</label>
          <input
            type="text"
            id="jobLocation"
            required
          >
        </div>

        <div class="input-group">
          <label for="salaryRange">Salary Range</label>
          <input
            type="text"
            id="salaryRange"
            placeholder="Example: ₹15,000–₹20,000"
          >
        </div>

        <div class="input-group full-width">
          <label for="jobRequirement">Job Description</label>

          <textarea
            id="jobRequirement"
            rows="5"
            placeholder="Mention duties, education, experience, shift and joining requirements"
            required
          ></textarea>
        </div>

        <button
          type="submit"
          class="button full-button full-width"
        >
          Submit Requirement
        </button>

        <div
          class="success-message full-width"
          id="employerSuccess"
        >
          Your hiring requirement has been submitted successfully.
        </div>

      </form>

    </div>
  </div>

  <script>
    const menuButton = document.getElementById("menuButton");
    const mainNavigation = document.getElementById("mainNavigation");

    menuButton.addEventListener("click", () => {
      mainNavigation.classList.toggle("open");
    });

    document.querySelectorAll("#mainNavigation a").forEach((link) => {
      link.addEventListener("click", () => {
        mainNavigation.classList.remove("open");
      });
    });

    document.getElementById("currentYear").textContent =
      new Date().getFullYear();

    /*
     * Category filtering
     */

    const categoryFilterButtons =
      document.querySelectorAll(".filter-button");

    const categoryCards =
      document.querySelectorAll(".category-card");

    categoryFilterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const selectedGroup = button.dataset.group;

        categoryFilterButtons.forEach((item) => {
          item.classList.remove("active");
        });

        button.classList.add("active");

        categoryCards.forEach((card) => {
          const cardGroup = card.dataset.group;

          if (
            selectedGroup === "all" ||
            cardGroup === selectedGroup
          ) {
            card.style.display = "block";
          } else {
            card.style.display = "none";
          }
        });
      });
    });

    /*
     * Main job search
     */

    const mainJobSearch =
      document.getElementById("mainJobSearch");

    const jobs =
      document.querySelectorAll(".job-card");

    const noResults =
      document.getElementById("noResults");

    function filterJobs() {
      const keyword =
        document
          .getElementById("searchKeyword")
          .value
          .trim()
          .toLowerCase();

      const location =
        document
          .getElementById("searchLocation")
          .value
          .trim()
          .toLowerCase();

      const category =
        document
          .getElementById("searchCategory")
          .value
          .trim()
          .toLowerCase();

      const selectedSidebarFilters =
        Array.from(
          document.querySelectorAll(".job-filter:checked")
        ).map((input) => input.value);

      let visibleJobs = 0;

      jobs.forEach((job) => {
        const title = job.dataset.title || "";
        const jobLocation = job.dataset.location || "";
        const jobCategory = job.dataset.category || "";
        const jobTags = job.dataset.tags || "";

        const keywordMatch =
          !keyword ||
          title.includes(keyword) ||
          job.textContent.toLowerCase().includes(keyword);

        const locationMatch =
          !location ||
          jobLocation.includes(location) ||
          job.textContent.toLowerCase().includes(location);

        const categoryMatch =
          !category ||
          jobCategory.includes(category);

        const sidebarMatch =
          selectedSidebarFilters.length === 0 ||
          selectedSidebarFilters.some((filter) =>
            jobTags.includes(filter)
          );

        if (
          keywordMatch &&
          locationMatch &&
          categoryMatch &&
          sidebarMatch
        ) {
          job.style.display = "block";
          visibleJobs++;
        } else {
          job.style.display = "none";
        }
      });

      noResults.style.display =
        visibleJobs === 0 ? "block" : "none";
    }

    mainJobSearch.addEventListener("submit", (event) => {
      event.preventDefault();
      filterJobs();

      document
        .getElementById("latestJobs")
        .scrollIntoView({
          behavior: "smooth"
        });
    });

    document.querySelectorAll(".job-filter").forEach((filter) => {
      filter.addEventListener("change", filterJobs);
    });

    /*
     * Save jobs
     */

    document.querySelectorAll(".save-button").forEach((button) => {
      button.addEventListener("click", () => {
        button.classList.toggle("saved");

        button.textContent =
          button.classList.contains("saved") ? "♥" : "♡";
      });
    });

    /*
     * Candidate application modal
     */

    const applicationModal =
      document.getElementById("applicationModal");

    const selectedJobText =
      document.getElementById("selectedJobText");

    document.querySelectorAll(".apply-button").forEach((button) => {
      button.addEventListener("click", () => {
        const jobName = button.dataset.job;

        selectedJobText.textContent =
          "You are applying for: " + jobName;

        applicationModal.classList.add("active");
      });
    });

    /*
     * Employer modal
     */

    const employerModal =
      document.getElementById("employerModal");

    document
      .getElementById("openEmployerModal")
      .addEventListener("click", () => {
        employerModal.classList.add("active");
      });

    /*
     * Close modal controls
     */

    document.querySelectorAll("[data-close-modal]").forEach(
      (button) => {
        button.addEventListener("click", () => {
          const modalId = button.dataset.closeModal;

          document
            .getElementById(modalId)
            .classList.remove("active");
        });
      }
    );

    document.querySelectorAll(".modal").forEach((modal) => {
      modal.addEventListener("click", (event) => {
        if (event.target === modal) {
          modal.classList.remove("active");
        }
      });
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        document.querySelectorAll(".modal").forEach(
          (modal) => modal.classList.remove("active")
        );
      }
    });

    /*
     * Demo form handling
     *
     * These forms currently show a success message.
     * Later, connect them to Cloudflare Worker, Formspree,
     * Firebase, Supabase or your preferred backend.
     */

    document
      .getElementById("quickAssistanceForm")
      .addEventListener("submit", (event) => {
        event.preventDefault();

        const successMessage =
          document.getElementById("quickSuccessMessage");

        successMessage.style.display = "block";

        event.target.reset();

        setTimeout(() => {
          successMessage.style.display = "none";
        }, 5000);
      });

    document
      .getElementById("applicationForm")
      .addEventListener("submit", (event) => {
        event.preventDefault();

        const successMessage =
          document.getElementById("applicationSuccess");

        successMessage.style.display = "block";

        event.target.reset();

        setTimeout(() => {
          applicationModal.classList.remove("active");
          successMessage.style.display = "none";
        }, 2200);
      });

    document
      .getElementById("employerForm")
      .addEventListener("submit", (event) => {
        event.preventDefault();

        const successMessage =
          document.getElementById("employerSuccess");

        successMessage.style.display = "block";

        event.target.reset();

        setTimeout(() => {
          employerModal.classList.remove("active");
          successMessage.style.display = "none";
        }, 2200);
      });
  </script>

