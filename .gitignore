# ==========================================
# MedOrbit Foundation - .gitignore
# ==========================================

# macOS
.DS_Store

# Windows
Thumbs.db
Desktop.ini

# VS Code
.vscode/

# JetBrains IDEs
.idea/

# Node.js (if added later)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.*

# Logs
*.log

# Temporary files
*.tmp
*.temp

# Backup files
*.bak
*.old
*.orig

# Cache
.cache/
.cache-loader/

# Build folders (for future frameworks)
dist/
build/

# Coverage reports
coverage/

# Operating system files
ehthumbs.db

# Service Worker cache
sw.js.map

# Generated files
*.map

# Python (if used later)
__pycache__/
*.pyc

# Keep this project clean
*.swp
*.swo